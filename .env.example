# Copia questo file in ".env" (o rinominalo) prima di avviare l'app.
# Il database SQLite verrà creato automaticamente al percorso indicato.
DATABASE_URL="file:./dev.db"

# Segreto per firmare le sessioni di login (cambialo in produzione)
AUTH_SECRET="genera-una-stringa-lunga-e-casuale"

# Account admin creato automaticamente al primo avvio se non esiste nessun utente
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123"
