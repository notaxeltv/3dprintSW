// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  category    String?
  subcategory String?
  imageUrl    String?
  material    String?
  printHours  Float?
  costPerUnit Float    @default(0)
  price       Float    @default(0)
  minStock    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  prints     PrintLog[]
  sales      SaleLog[]
  variants   ProductVariant[]
  images     ProductImage[]
  markups    ShopProductMarkup[]
  shopSales  ShopSaleLog[]
  orderItems ShopOrderItem[]
}

model Shop {
  id        String   @id @default(cuid())
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User?
  markups   ShopProductMarkup[]
  shopSales ShopSaleLog[]
  orders    ShopOrder[]
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         String
  shopId       String?  @unique
  shop         Shop?    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ShopProductMarkup {
  id            String  @id @default(cuid())
  shopId        String
  shop          Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  productId     String
  product       Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  markupPercent Float   @default(0)

  @@unique([shopId, productId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  caption   String?
  order     Int     @default(0)
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  label     String?
  height    Float
  width     Float
  depth     Float
  price     Float
  order     Int     @default(0)

  shopSales  ShopSaleLog[]
  orderItems ShopOrderItem[]
}

model Settings {
  id           Int     @id @default(1)
  companyName  String  @default("La mia azienda")
  logoUrl      String?
  instagramUrl String?
  facebookUrl  String?
  tiktokUrl    String?
  youtubeUrl   String?
  whatsappUrl  String?
  telegramUrl  String?
  linkedinUrl  String?
  xUrl         String?
  websiteUrl   String?
  email        String?
}

model PrintLog {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int
  unitCost  Float
  printedAt DateTime @default(now())
  notes     String?
  createdAt DateTime @default(now())
}

model SaleLog {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int
  unitPrice Float
  soldAt    DateTime @default(now())
  buyer     String?
  notes     String?
  createdAt DateTime @default(now())
}

model ShopSaleLog {
  id                 String          @id @default(cuid())
  shopId             String
  shop               Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  productId          String
  product            Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId          String?
  variant            ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantity           Int
  unitWholesalePrice Float
  unitRetailPrice    Float
  soldAt             DateTime        @default(now())
  buyer              String?
  notes              String?
  createdAt          DateTime        @default(now())
}

model ShopOrder {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  status    String   @default("PENDING")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items ShopOrderItem[]
}

model ShopOrderItem {
  id                 String          @id @default(cuid())
  orderId            String
  order              ShopOrder       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId          String
  product            Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId          String?
  variant            ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productName        String
  variantLabel       String?
  quantity           Int
  unitWholesalePrice Float
}
